{
  "comments": {
    "lineComment": "#"
  },
  "brackets": [
    ["(", ")"],
    ["[", "]"],
    ["{", "}"]
  ],
  "autoClosingPairs": [
    { "open": "(", "close": ")" },
    { "open": "[", "close": "]" },
    { "open": "{", "close": "}" },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] },
    { "open": "'",  "close": "'",  "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [
    ["(", ")"],
    ["[", "]"],
    ["{", "}"],
    ["\"", "\""],
    ["'", "'"]
  ],
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(if|elif|else|for|repeat|while|fn|task|server|route|match|taskgroup)\\b.*:\\s*$",
    "decreaseIndentPattern": "^\\s*(elif|else)\\b"
  },
  "onEnterRules": [
    {
      "beforeText": ".*:\\s*$",
      "action": { "indent": "indent" }
    }
  ],
  "wordPattern": "[a-zA-Z_][a-zA-Z0-9_]*|->|:=|=>|\\?",
  "folding": {
    "markers": {
      "start": "^\\s*(fn|if|for|repeat|task|server|type)\\b",
      "end":   "^\\s*$"
    }
  }
}
